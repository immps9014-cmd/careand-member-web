# Laravel 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# 환경 (development | production)
NEXT_PUBLIC_ENV=development

# PG 결제 (비우면 스텁 결제 — 실제 카드 청구 없음)
# 실결제: PROVIDER=portone + STORE_ID(가맹점 식별코드) 설정 + 백엔드 PG_MID/PG_API_KEY + EXTERNAL_STUB=false
NEXT_PUBLIC_PG_PROVIDER=
NEXT_PUBLIC_PG_STORE_ID=
NEXT_PUBLIC_PG_CHANNEL=html5_inicis
