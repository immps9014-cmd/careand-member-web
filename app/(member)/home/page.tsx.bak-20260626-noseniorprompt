          <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#0E6B43" strokeWidth="1.7"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0z" /><path d="M4 21c.7-3.8 3.6-6 8-6s7.3 2.2 8 6" /></svg>
